---
const { title = "Launch Baseball", description = "Open hitting instruction built around the movement principles shared by successful hitters." } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="theme-color" content="#071421"/><title>{title}</title><style is:global>
:root{--navy:#071421;--navy2:#0c223a;--red:#d3292f;--paper:#f4f1ea;--ink:#0b1723;--muted:#8c99a5;--line:rgba(255,255,255,.12)}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;background:var(--navy);color:white;line-height:1.58}a{color:inherit}.container{width:min(1180px,90%);margin-inline:auto}.eyebrow{margin:0 0 .75rem;color:var(--red);font-size:.74rem;font-weight:950;letter-spacing:.18em;text-transform:uppercase}.button{display:inline-flex;align-items:center;justify-content:center;padding:.95rem 1.25rem;border-radius:.35rem;text-decoration:none;text-transform:uppercase;letter-spacing:.065em;font-size:.78rem;font-weight:950}.button-primary{background:var(--red)}.button-ghost{border:1px solid rgba(255,255,255,.32)}.text-link{color:var(--red);text-decoration:none;font-weight:900}h1,h2,h3{line-height:.98;letter-spacing:-.035em}
</style></head><body><header class="site-header"><div class="container nav"><a class="brand" href="/"><span class="mark">L</span><span>Launch <b>Baseball</b></span></a><nav><a href="/learn">Learn</a><a href="/assessment">Launch Assessment</a><a href="/about">About</a><a class="quiet" href="/assessment#book">Book Now</a></nav></div></header><slot/><footer><div class="container foot"><div><strong>Launch Baseball</strong><p>Open principles. Individual application.</p></div><div><a href="/learn">Learn</a><a href="/assessment">Assessment</a><a href="/about">About</a></div><div class="right"><a href="mailto:info@launchbaseball.net">info@launchbaseball.net</a><span>© 2026 Launch Baseball</span></div></div></footer><style>
.site-header{position:sticky;top:0;z-index:30;background:rgba(7,20,33,.9);backdrop-filter:blur(15px);border-bottom:1px solid var(--line)}.nav{min-height:74px;display:flex;align-items:center;justify-content:space-between;gap:2rem}.brand{display:inline-flex;align-items:center;gap:.7rem;text-decoration:none;text-transform:uppercase;font-weight:950;letter-spacing:.075em}.brand b{color:var(--red)}.mark{display:grid;place-items:center;width:34px;height:34px;background:var(--red);transform:skew(-9deg);font-style:italic}nav{display:flex;gap:1.25rem;align-items:center}nav a{text-decoration:none;color:#b5c0ca;font-size:.86rem;font-weight:850}.quiet{color:white;border-bottom:1px solid var(--red);padding-bottom:.18rem}footer{background:#03080d;color:#8794a0;padding:2.4rem 0;border-top:1px solid var(--line)}.foot{display:grid;grid-template-columns:1fr auto 1fr;gap:2rem}.foot strong{display:block;color:white;text-transform:uppercase}.foot p{margin:.25rem 0 0}.foot>div:nth-child(2),.right{display:flex;flex-direction:column;gap:.35rem}.foot a{text-decoration:none}.right{align-items:flex-end}@media(max-width:760px){nav a:not(.quiet){display:none}.foot{grid-template-columns:1fr}.right{align-items:flex-start}}
</style></body></html>
