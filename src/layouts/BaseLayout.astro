---
const {
  title = "Launch Baseball",
  description = "Open hitting instruction built around the movement principles shared by successful hitters.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#071421" />
    <title>{title}</title>

    <style is:global>
      :root {
        --navy: #071421;
        --navy2: #0c223a;
        --red: #d3292f;
        --paper: #f4f1ea;
        --ink: #0b1723;
        --muted: #8c99a5;
        --line: rgba(255, 255, 255, 0.12);
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
        background: var(--navy);
        color: white;
        line-height: 1.58;
      }
      body.menu-open { overflow: hidden; }
      a { color: inherit; }
      .container { width: min(1180px, 90%); margin-inline: auto; }
      .eyebrow {
        margin: 0 0 0.75rem;
        color: var(--red);
        font-size: 0.74rem;
        font-weight: 950;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }
      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.95rem 1.25rem;
        border-radius: 0.35rem;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.065em;
        font-size: 0.78rem;
        font-weight: 950;
      }
      .button-primary { background: var(--red); }
      .button-ghost { border: 1px solid rgba(255, 255, 255, 0.32); }
      .text-link { color: var(--red); text-decoration: none; font-weight: 900; }
      h1, h2, h3 { line-height: 0.98; letter-spacing: -0.035em; }
    </style>
  </head>

  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href="/">
          <span class="mark">L</span>
          <span>Launch <b>Baseball</b></span>
        </a>

        <nav class="desktop-nav" aria-label="Primary navigation">
          <a href="/learn">Learn</a>
          <a href="/assessment">Launch Assessment</a>
          <a href="/about">About</a>
          <a class="quiet" href="/assessment#book">Book Now</a>
        </nav>

        <button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open navigation menu"
          data-menu-toggle
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </header>

    <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
      <nav class="mobile-nav" aria-label="Mobile navigation">
        <a href="/learn">Learn</a>
        <a href="/assessment">Launch Assessment</a>
        <a href="/about">About</a>
        <a class="mobile-book" href="/assessment#book">Book an Assessment</a>
      </nav>
    </div>

    <slot />

    <footer>
      <div class="container foot">
        <div>
          <strong>Launch Baseball</strong>
          <p>Open principles. Individual application.</p>
        </div>

        <div>
          <a href="/learn">Learn</a>
          <a href="/assessment">Assessment</a>
          <a href="/about">About</a>
        </div>

        <div class="right">
          <a href="mailto:info@launchbaseball.net">info@launchbaseball.net</a>
          <span>© 2026 Launch Baseball</span>
        </div>
      </div>
    </footer>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(7, 20, 33, 0.94);
        backdrop-filter: blur(15px);
        border-bottom: 1px solid var(--line);
      }
      .nav {
        min-height: 74px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        text-decoration: none;
        text-transform: uppercase;
        font-weight: 950;
        letter-spacing: 0.075em;
      }
      .brand b { color: var(--red); }
      .mark {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        background: var(--red);
        transform: skew(-9deg);
        font-style: italic;
      }
      .desktop-nav {
        display: flex;
        gap: 1.25rem;
        align-items: center;
      }
      .desktop-nav a {
        text-decoration: none;
        color: #b5c0ca;
        font-size: 0.86rem;
        font-weight: 850;
      }
      .desktop-nav a:hover { color: white; }
      .desktop-nav .quiet {
        color: white;
        border-bottom: 1px solid var(--red);
        padding-bottom: 0.18rem;
      }
      .menu-toggle {
        display: none;
        width: 44px;
        height: 44px;
        padding: 10px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 6px;
        background: transparent;
        cursor: pointer;
      }
      .menu-toggle span {
        display: block;
        width: 100%;
        height: 2px;
        margin: 5px 0;
        background: white;
        transform-origin: center;
        transition: transform 0.2s ease, opacity 0.2s ease;
      }
      .menu-toggle.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
      .menu-toggle.is-open span:nth-child(2) { opacity: 0; }
      .menu-toggle.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
      .mobile-menu {
        position: fixed;
        top: 74px;
        left: 0;
        right: 0;
        z-index: 49;
        height: calc(100vh - 74px);
        padding: 24px 5%;
        background: #071421;
        overflow-y: auto;
      }
      .mobile-menu[hidden] { display: none; }
      .mobile-nav {
        display: grid;
        width: min(90%, 560px);
        margin: 0 auto;
        padding: 2rem 0 4rem;
      }
      .mobile-nav a {
        display: block;
        padding: 18px 4px;
        color: white;
        font-size: 28px;
        font-weight: 900;
        line-height: 1;
        text-decoration: none;
        text-transform: uppercase;
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
      }
      .mobile-nav a:hover,
      .mobile-nav a:focus-visible {
        color: var(--red);
        outline: none;
      }
      .mobile-nav .mobile-book {
        margin-top: 24px;
        padding: 16px;
        background: var(--red);
        border: 0;
        border-radius: 6px;
        text-align: center;
        font-size: 16px;
      }
      footer {
        background: #03080d;
        color: #8794a0;
        padding: 2.4rem 0;
        border-top: 1px solid var(--line);
      }
      .foot {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 2rem;
      }
      .foot strong {
        display: block;
        color: white;
        text-transform: uppercase;
      }
      .foot p { margin: 0.25rem 0 0; }
      .foot > div:nth-child(2),
      .right {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
      }
      .foot a { text-decoration: none; }
      .right { align-items: flex-end; }
      @media (max-width: 760px) {
        .desktop-nav { display: none; }
        .menu-toggle { display: block; }
        .foot { grid-template-columns: 1fr; }
        .right { align-items: flex-start; }
      }
    </style>

    <script is:inline>
      (() => {
        const toggle = document.querySelector('[data-menu-toggle]');
        const menu = document.querySelector('[data-mobile-menu]');

        if (!toggle || !menu) return;

        const closeMenu = () => {
          toggle.classList.remove('is-open');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'Open navigation menu');
          menu.hidden = true;
          document.body.classList.remove('menu-open');
        };

        const openMenu = () => {
          toggle.classList.add('is-open');
          toggle.setAttribute('aria-expanded', 'true');
          toggle.setAttribute('aria-label', 'Close navigation menu');
          menu.hidden = false;
          document.body.classList.add('menu-open');
        };

        toggle.addEventListener('click', () => {
          const isOpen = toggle.getAttribute('aria-expanded') === 'true';
          if (isOpen) closeMenu();
          else openMenu();
        });

        menu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', closeMenu);
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') closeMenu();
        });

        window.addEventListener('resize', () => {
          if (window.innerWidth > 760) closeMenu();
        });
      })();
    </script>
  </body>
</html>
