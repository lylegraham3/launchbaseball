---
import BaseLayout from './BaseLayout.astro';
const { title, number, problem, definition, purpose, misconception, nextTitle, nextHref } = Astro.props;
---
<BaseLayout title={`${title} | Launch Baseball`}>
  <main>
    <section class="chapter-hero">
      <div class="container">
        <p class="eyebrow">Chapter {number}</p>
        <h1>{title}</h1>
        <p class="problem">The problem it solves: <strong>{problem}</strong></p>
      </div>
    </section>
    <section class="paper">
      <div class="container chapter-grid">
        <article>
          <h2>What it is</h2>
          <p>{definition}</p>
          <h2>Why it matters</h2>
          <p>{purpose}</p>
          <h2>Common misconception</h2>
          <p>{misconception}</p>
          <div class="chapter-quote"><slot name="quote" /></div>
        </article>
        <aside>
          <p class="aside-label">Apply it to your swing</p>
          <p>Understanding the principle is different from knowing how it affects your movement.</p>
          <a class="text-link" href="/assessment">See the Launch Assessment →</a>
        </aside>
      </div>
    </section>
    <section class="next">
      <div class="container next-inner">
        <span>Next chapter</span>
        <a href={nextHref}>{nextTitle} →</a>
      </div>
    </section>
  </main>
  <style>
    .chapter-hero{padding:7rem 0 5rem;background:radial-gradient(circle at 80% 20%,rgba(211,41,47,.2),transparent 28%),linear-gradient(135deg,var(--navy),var(--navy-2))}
    h1{margin:.5rem 0 1rem;font-size:clamp(4rem,10vw,8rem);text-transform:uppercase}.problem{color:#b8c4cf;font-size:1.05rem}.problem strong{color:white}
    .paper{background:var(--paper);color:var(--ink);padding:6rem 0}.chapter-grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:5rem;align-items:start}article{max-width:760px}article h2{margin:3rem 0 .8rem;font-size:2rem;text-transform:uppercase}article h2:first-child{margin-top:0}article p{color:#3e4a55;font-size:1.1rem}
    aside{position:sticky;top:110px;padding:1.4rem;border-left:4px solid var(--red);background:white}.aside-label{margin:0;color:var(--red);text-transform:uppercase;letter-spacing:.1em;font-size:.72rem;font-weight:950}aside p{color:#4d5964}
    .chapter-quote{margin-top:4rem;padding:2.5rem 0 0;border-top:1px solid var(--paper-line);font-size:clamp(2rem,4vw,3.7rem);font-weight:950;line-height:1;text-transform:uppercase}
    .next{background:#0a1c30}.next-inner{min-height:180px;display:flex;justify-content:space-between;align-items:center;gap:2rem}.next span{color:var(--muted);text-transform:uppercase;font-size:.75rem;letter-spacing:.14em;font-weight:900}.next a{text-decoration:none;font-size:clamp(2rem,4vw,4rem);font-weight:950;text-transform:uppercase}
    @media(max-width:820px){.chapter-grid{grid-template-columns:1fr}aside{position:static}.next-inner{align-items:flex-start;flex-direction:column;justify-content:center}}
  </style>
</BaseLayout>
