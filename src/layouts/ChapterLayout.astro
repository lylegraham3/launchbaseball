---
import BaseLayout from './BaseLayout.astro';

const {
  title,
  number,
  problem,

  // Foundation content
  definition,
  purpose,
  misconception,

  // Pillar chapter content
  openingThought,
  closingStatement,
  transitionQuestion,
deepDiveHref,
deepDiveTitle,

  // Navigation
  nextTitle,
  nextHref,
  nextDescription = "Continue through the Launch Baseball hitting curriculum.",
  nextLinkText
} = Astro.props;

const chapters = [
  { title: "Foundation", href: "/learn/foundation" },
  { title: "Load", href: "/learn/load" },
  { title: "Balance", href: "/learn/balance" },
  { title: "Sequence", href: "/learn/sequence" },
  { title: "Barrel Path", href: "/learn/barrel-path" },
  { title: "Adjustability", href: "/learn/adjustability" }
];

const chapterNumber = Number(number);

const isFoundation =
  title === "Foundation" ||
  Boolean(definition) ||
  Boolean(purpose) ||
  Boolean(misconception);

const resolvedNextLinkText =
  nextLinkText ??
  (chapterNumber < 5
    ? `Chapter ${chapterNumber + 1} — ${nextTitle}`
    : nextTitle);
---

<BaseLayout title={`${title} | Launch Baseball`}>
  <div class="reading-progress" aria-hidden="true">
    <div class="reading-progress-bar"></div>
  </div>

  <main>
    <section class="chapter-hero">
      <div class="container">
        <p class="eyebrow">Chapter {number}</p>
        <h1>{title}</h1>

        <p class="problem">
          The problem it solves: <strong>{problem}</strong>
        </p>
      </div>
    </section>

    <nav class="chapter-nav" aria-label="Hitting chapters">
      <div class="container chapter-nav-inner">
        {chapters.map((chapter) => (
          <a
            href={chapter.href}
            class:list={[
              "chapter-link",
              { active: chapter.title === title }
            ]}
            aria-current={chapter.title === title ? "page" : undefined}
          >
            {chapter.title}
          </a>
        ))}
      </div>
    </nav>

    {
      openingThought && (
        <section class="opening">
          <div class="container opening-inner">
            <p class="opening-label">Opening thought</p>
            <blockquote>{openingThought}</blockquote>
          </div>
        </section>
      )
    }

    <section class="paper">
      <div class="container chapter-body">
        {
          isFoundation ? (
            <article>
              <section class="foundation-section">
                <h2>What it is</h2>
                <p>{definition}</p>
              </section>

              <section class="foundation-section">
                <h2>Why it matters</h2>
                <p>{purpose}</p>
              </section>

              <section class="foundation-section">
                <h2>Common misconception</h2>
                <p>{misconception}</p>
              </section>

              <div class="chapter-quote">
                <slot name="quote" />
              </div>
            </article>
          ) : (
            <article>
              <slot />
            </article>
          )
        }
      </div>
    </section>

    <section class="chapter-close">
      <div class="container close-inner">
        {
          closingStatement && (
            <p class="closing-statement">{closingStatement}</p>
          )
        }

        {
          transitionQuestion && (
            <h2>{transitionQuestion}</h2>
          )
        }

        <p class="next-description">{nextDescription}</p>

<div class="chapter-actions">
  <a class="chapter-action" href={nextHref}>
    <strong>{resolvedNextLinkText} →</strong>
  </a>

  {
    deepDiveHref && (
      <a class="chapter-action" href={deepDiveHref}>
<strong>{deepDiveTitle ?? `Deep Dive into ${title}`} →</strong>
      </a>
    )
  }
</div>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const bar = document.querySelector('.reading-progress-bar');

      if (!bar) return;

      const updateProgress = () => {
        const scrollTop =
          window.scrollY || document.documentElement.scrollTop;

        const scrollable =
          document.documentElement.scrollHeight - window.innerHeight;

        const progress =
          scrollable > 0
            ? Math.min(1, Math.max(0, scrollTop / scrollable))
            : 0;

        bar.style.transform = `scaleX(${progress})`;
      };

      updateProgress();

      window.addEventListener('scroll', updateProgress, {
        passive: true
      });

      window.addEventListener('resize', updateProgress);
    })();
  </script>

  <style>
    .reading-progress {
      position: fixed;
      top: 74px;
      left: 0;
      right: 0;
      z-index: 50;
      height: 3px;
      background: rgba(255, 255, 255, 0.08);
      pointer-events: none;
    }

    .reading-progress-bar {
      width: 100%;
      height: 100%;
      background: var(--red);
      transform: scaleX(0);
      transform-origin: left center;
      will-change: transform;
    }

    .chapter-hero {
      padding: 7rem 0 5rem;
      background:
        radial-gradient(
          circle at 80% 20%,
          rgba(211, 41, 47, 0.2),
          transparent 28%
        ),
        linear-gradient(135deg, var(--navy), var(--navy-2));
    }

    h1 {
      margin: 0.5rem 0 1rem;
      font-size: clamp(4rem, 10vw, 8rem);
      line-height: 0.9;
      text-transform: uppercase;
    }

    .problem {
      margin: 0;
      color: #b8c4cf;
      font-size: 1.05rem;
    }

    .problem strong {
      color: white;
    }

    .chapter-nav {
      position: sticky;
      top: 74px;
      z-index: 40;
      background: #06111f;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .chapter-nav-inner {
      display: flex;
      gap: 0.35rem;
      overflow-x: auto;
      padding-top: 0.55rem;
      padding-bottom: 0.55rem;
      scrollbar-width: thin;
    }

    .chapter-link {
      flex: 0 0 auto;
      padding: 0.55rem 0.75rem;
      color: #9eabb7;
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      font-size: 0.7rem;
      font-weight: 900;
      white-space: nowrap;
    }

    .chapter-link:hover {
      color: white;
    }

    .chapter-link.active {
      color: var(--red);
    }

    .opening {
      padding: clamp(5rem, 10vw, 9rem) 0;
      background: #0a1c30;
      color: white;
    }

    .opening-inner {
      max-width: 1050px;
    }

    .opening-label {
      margin: 0 0 2rem;
      color: var(--red);
      font-size: 0.72rem;
      font-weight: 950;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    blockquote {
      max-width: 13ch;
      margin: 0;
      font-size: clamp(3rem, 7vw, 6.5rem);
      font-weight: 950;
      line-height: 0.95;
      letter-spacing: -0.045em;
      text-transform: uppercase;
    }

    .paper {
      padding: clamp(5rem, 9vw, 8rem) 0;
      background: var(--paper);
      color: var(--ink);
    }

    .chapter-body {
      max-width: 900px;
    }

    article {
      max-width: 760px;
    }

    .foundation-section + .foundation-section {
      margin-top: 3.5rem;
    }

    article :global(h2),
    .foundation-section h2 {
      margin: 0 0 1rem;
      font-size: clamp(2.5rem, 5vw, 4.5rem);
      line-height: 0.95;
      text-transform: uppercase;
    }

    article :global(p),
    .foundation-section p {
      margin: 0 0 1.25rem;
      color: #3e4a55;
      font-size: clamp(1.08rem, 2vw, 1.3rem);
      line-height: 1.7;
    }

    article :global(.emphasis) {
      margin: 3rem 0;
      padding-left: 1.5rem;
      border-left: 4px solid var(--red);
      color: var(--ink);
      font-size: clamp(1.4rem, 3vw, 2rem);
      font-weight: 900;
      line-height: 1.25;
    }

    article :global(.final-thought) {
      margin-top: 4rem;
      color: var(--ink);
      font-size: clamp(1.8rem, 4vw, 3rem);
      font-weight: 950;
      line-height: 1.05;
      text-transform: uppercase;
    }

    .chapter-quote {
      margin-top: 4rem;
      padding-top: 2.5rem;
      border-top: 1px solid var(--paper-line);
      font-size: clamp(1.8rem, 3.6vw, 3.2rem);
      font-weight: 950;
      line-height: 1.05;
      text-transform: uppercase;
    }

    .chapter-close {
      padding: clamp(5rem, 9vw, 8rem) 0;
      background: #06111f;
      color: white;
    }

    .close-inner {
      max-width: 1100px;
    }

    .closing-statement {
      max-width: 850px;
      margin: 0 0 2rem;
      color: #aeb9c3;
      font-size: clamp(1.2rem, 2.5vw, 1.65rem);
      line-height: 1.5;
    }

    .chapter-close h2 {
      max-width: 900px;
      margin: 0;
      font-size: clamp(3rem, 7vw, 6rem);
      line-height: 0.95;
      text-transform: uppercase;
    }

    .next-description {
      max-width: 720px;
      margin: 2rem 0 0;
      color: #8f9ba7;
      font-size: 1rem;
      line-height: 1.6;
    }

    .chapter-actions {
      display: grid;
      gap: 1rem;
      max-width: 700px;
      margin-top: 2.5rem;
    }

    .chapter-action {
      min-height: 104px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 1.3rem 1.45rem;
      color: white;
      border: 1px solid rgba(255, 255, 255, 0.18);
      background: rgba(255, 255, 255, 0.015);
      text-decoration: none;
      transition:
        transform 200ms ease,
        border-color 200ms ease,
        background-color 200ms ease;
    }

    .action-label {
      display: block;
      margin-bottom: 0.45rem;
      color: #8f9ba7;
      font-size: 0.7rem;
      font-weight: 900;
      letter-spacing: 0.1em;
      line-height: 1;
      text-transform: uppercase;
      transition: color 200ms ease;
    }

    .action-destination {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .action-destination strong {
      font-size: clamp(1.15rem, 2.4vw, 1.6rem);
      line-height: 1.1;
      text-transform: uppercase;
      transition: color 200ms ease;
    }

    .action-destination i {
      flex: 0 0 auto;
      font-size: 1.55rem;
      font-style: normal;
      transition:
        color 200ms ease,
        transform 200ms ease;
    }

    .chapter-action:hover {
      transform: translateY(-4px);
      border-color: var(--red);
      background: rgba(211, 41, 47, 0.08);
    }

    .chapter-action:hover .action-label,
    .chapter-action:hover strong,
    .chapter-action:hover i {
      color: var(--red);
    }

    .chapter-action:hover i {
      transform: translateX(5px);
    }

    .chapter-action:focus-visible {
      outline: 3px solid var(--red);
      outline-offset: 4px;
    }

    @media (max-width: 760px) {
      .chapter-hero {
        padding: 5rem 0 4rem;
      }

      .chapter-action {
        min-height: 94px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .chapter-action,
      .chapter-action i {
        transition: none;
      }

      .chapter-action:hover,
      .chapter-action:hover i {
        transform: none;
      }
    }
  </style>
</BaseLayout>