---
import BaseLayout from './BaseLayout.astro';

const {
  title,
  number,
  problem,
  definition,
  purpose,
  misconception,
  nextTitle,
  nextHref,
  nextDescription = "Continue through the Launch Baseball hitting curriculum."
} = Astro.props;

const chapters = [
  { title: "Foundation", href: "/learn/foundation" },
  { title: "Load", href: "/learn/load" },
  { title: "Balance", href: "/learn/balance" },
  { title: "Sequence", href: "/learn/sequence" },
  { title: "Barrel Path", href: "/learn/barrel-path" },
  { title: "Adjustability", href: "/learn/adjustability" }
];
---
<BaseLayout title={`${title} | Launch Baseball`}>
  <main>
    <section class="chapter-hero">
      <div class="container">
        <p class="eyebrow">Chapter {number}</p>
        <h1>{title}</h1>
        <p class="problem">The problem it solves: <strong>{problem}</strong></p>
      </div>
    </section>

    <nav class="chapter-nav" aria-label="Hitting chapters">
      <div class="container chapter-nav-inner">
        {chapters.map((chapter) => (
          <a
            href={chapter.href}
            class:list={["chapter-link", { active: chapter.title === title }]}
            aria-current={chapter.title === title ? "page" : undefined}
          >
            {chapter.title}
          </a>
        ))}
      </div>
    </nav>

    <section class="paper">
      <div class="container chapter-grid">
        <article>
          <h2>What it is</h2>
          <p>{definition}</p>

          <h2>Why it matters</h2>
          <p>{purpose}</p>

          <h2>Common misconception</h2>
          <p>{misconception}</p>

          <div class="chapter-quote">
            <slot name="quote" />
          </div>
        </article>

        <aside>
          <p class="aside-label">Apply it to your swing</p>
          <p>
            Understanding the principle is different from knowing how it affects your movement.
          </p>
          <a class="text-link" href="/assessment">See the Launch Assessment →</a>
        </aside>
      </div>
    </section>

    <nav class="chapter-nav chapter-nav-bottom" aria-label="Hitting chapters">
      <div class="container chapter-nav-inner">
        {chapters.map((chapter) => (
          <a
            href={chapter.href}
            class:list={["chapter-link", { active: chapter.title === title }]}
            aria-current={chapter.title === title ? "page" : undefined}
          >
            {chapter.title}
          </a>
        ))}
      </div>
    </nav>

    <section class="next">
      <div class="container next-inner">
        <div>
          <span>Next chapter</span>
          <h2>{nextTitle}</h2>
          <p>{nextDescription}</p>
        </div>
        <a href={nextHref}>Continue →</a>
      </div>
    </section>
  </main>

  <style>
    .chapter-hero {
      padding: 7rem 0 5rem;
      background:
        radial-gradient(circle at 80% 20%, rgba(211,41,47,.2), transparent 28%),
        linear-gradient(135deg, var(--navy), var(--navy-2));
    }
    h1 {
      margin: .5rem 0 1rem;
      font-size: clamp(4rem, 10vw, 8rem);
      text-transform: uppercase;
    }
    .problem { color: #b8c4cf; font-size: 1.05rem; }
    .problem strong { color: white; }

    .chapter-nav {
      background: #06111f;
      border-top: 1px solid rgba(255,255,255,.08);
      border-bottom: 1px solid rgba(255,255,255,.08);
    }
    .chapter-nav-inner {
      display: flex;
      gap: .35rem;
      overflow-x: auto;
      padding-top: .72rem;
      padding-bottom: .72rem;
      scrollbar-width: thin;
    }
    .chapter-link {
      flex: 0 0 auto;
      padding: .62rem .85rem;
      border-radius: .25rem;
      color: #9eabb7;
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: .07em;
      font-size: .72rem;
      font-weight: 900;
      white-space: nowrap;
    }
    .chapter-link:hover { color: white; background: rgba(255,255,255,.06); }
    .chapter-link.active {
      color: white;
      background: var(--red);
    }
    .chapter-nav-bottom {
      border-top-color: rgba(255,255,255,.12);
    }

    .paper { background: var(--paper); color: var(--ink); padding: 6rem 0; }
    .chapter-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: 5rem;
      align-items: start;
    }
    article { max-width: 760px; }
    article h2 {
      margin: 3rem 0 .8rem;
      font-size: 2rem;
      text-transform: uppercase;
    }
    article h2:first-child { margin-top: 0; }
    article p { color: #3e4a55; font-size: 1.1rem; }
    aside {
      position: sticky;
      top: 110px;
      padding: 1.4rem;
      border-left: 4px solid var(--red);
      background: white;
    }
    .aside-label {
      margin: 0;
      color: var(--red);
      text-transform: uppercase;
      letter-spacing: .1em;
      font-size: .72rem;
      font-weight: 950;
    }
    aside p { color: #4d5964; }
    .chapter-quote {
      margin-top: 4rem;
      padding: 2.5rem 0 0;
      border-top: 1px solid var(--paper-line);
      font-size: clamp(1.8rem, 3.6vw, 3.2rem);
      font-weight: 950;
      line-height: 1.05;
      text-transform: uppercase;
    }

    .next { background: #0a1c30; }
    .next-inner {
      min-height: 230px;
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 3rem;
    }
    .next span {
      color: var(--red);
      text-transform: uppercase;
      font-size: .75rem;
      letter-spacing: .14em;
      font-weight: 900;
    }
    .next h2 {
      margin: .5rem 0;
      font-size: clamp(2.5rem, 5vw, 5rem);
      text-transform: uppercase;
    }
    .next p {
      margin: 0;
      max-width: 680px;
      color: #9eabb7;
      font-size: 1rem;
    }
    .next a {
      padding: .95rem 1.2rem;
      border: 1px solid rgba(255,255,255,.28);
      border-radius: .35rem;
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: .06em;
      font-size: .8rem;
      font-weight: 950;
      white-space: nowrap;
    }
    .next a:hover { background: var(--red); border-color: var(--red); }

    @media (max-width: 820px) {
      .chapter-grid { grid-template-columns: 1fr; }
      aside { position: static; }
      .next-inner {
        grid-template-columns: 1fr;
        gap: 1.5rem;
        padding-top: 3rem;
        padding-bottom: 3rem;
      }
      .next a { justify-self: start; }
    }
  </style>
</BaseLayout>
