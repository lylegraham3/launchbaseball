---
const { title, problem, href } = Astro.props;
---

<a class="card" href={href}>
  <div class="card-copy">
    <p>{problem}</p>
    <h3>{title}</h3>
  </div>

  <span class="arrow">
    Read chapter <i aria-hidden="true">→</i>
  </span>
</a>

<style>
  .card {
    min-height: 245px;
    padding: 1.6rem 1.35rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: var(--ink);
    text-decoration: none;
    border: 1px solid rgba(11, 23, 35, 0.1);
    background: rgba(255, 255, 255, 0.16);
    box-shadow: 0 0 0 rgba(11, 23, 35, 0);
    transition:
      transform 220ms ease,
      box-shadow 220ms ease,
      border-color 220ms ease,
      background-color 220ms ease;
  }

  .card:hover {
    transform: translateY(-7px);
    border-color: rgba(211, 41, 47, 0.4);
    background: rgba(255, 255, 255, 0.48);
    box-shadow: 0 16px 28px rgba(11, 23, 35, 0.12);
  }

  .card-copy {
    margin-top: auto;
    margin-bottom: auto;
  }

  p {
    margin: 0 0 0.75rem;
    color: #8fa0b0;
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    font-size: 1.7rem;
    line-height: 1;
    text-transform: uppercase;
    transition: color 220ms ease;
  }

  .arrow {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: #aab5c0;
    font-size: 0.8rem;
    font-weight: 850;
    transition: color 220ms ease;
  }

  .arrow i {
    font-style: normal;
    transition: transform 220ms ease;
  }

.card:hover h3 {
    color: var(--red);
}

.card:hover .arrow,
.card:hover .arrow i {
    color: var(--red);
}

  .card:hover .arrow i {
    transform: translateX(5px);
  }

  .card:focus-visible {
    outline: 3px solid var(--red);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    h3,
    .arrow,
    .arrow i {
      transition: none;
    }

    .card:hover,
    .card:hover .arrow i {
      transform: none;
    }
  }
</style>