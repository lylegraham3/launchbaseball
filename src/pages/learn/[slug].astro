---
import BaseLayout from '../../layouts/BaseLayout.astro';
const chapters={
foundation:{number:'00',title:'Foundation',problem:'Understanding',definition:'The foundation is the collection of movement principles consistently shared by successful hitters. While every player develops an individual style, the underlying principles remain the same. At Launch Baseball, these principles are organized into the Five Pillars.',purpose:'The foundation replaces guesswork with a clear framework. Players learn why movement works, why it breaks down, and how the pieces connect.',misconception:'The foundation is not one perfect swing or one required style. It is the set of principles each successful hitter must solve in their own way.',quote:'Individual style changes. The principles remain.',nextTitle:'Load',nextHref:'/learn/load'},
load:{number:'01',title:'Load',problem:'Preparation',definition:'The load is the movement that prepares the body to move explosively, efficiently, and under control. The appearance may differ from player to player, but the purpose remains the same.',purpose:'Explosive movement does not happen efficiently from a standstill. The load starts movement—like revving the engine before the clutch drops.',misconception:'A load is not simply moving backward, and a bigger load does not automatically create more power. It should prepare movement, not add movement for its own sake.',quote:'A load is not the swing. It is the preparation for the swing.',nextTitle:'Balance',nextHref:'/learn/balance'},
balance:{number:'02',title:'Balance',problem:'Control',definition:'Balance is the ability to remain athletic, controlled, and capable of continuing the movement throughout the swing.',purpose:'Balance allows the hitter to produce movement instead of spending the swing recovering from it.',misconception:'Balance does not mean staying still or keeping equal weight on both feet. Good hitters move. Balance is control while moving.',quote:'Balance is not the absence of movement. It is control within movement.',nextTitle:'Sequence',nextHref:'/learn/sequence'},
sequence:{number:'03',title:'Sequence',problem:'Coordination',definition:'Sequence is the order and timing that allow each part of the body to contribute to the swing without competing against the others.',purpose:'A quality sequence allows the body to transfer force efficiently and express more of the player’s available speed and power.',misconception:'Sequence is not simply “hips first.” It is coordinated movement in which each segment contributes at the correct time.',quote:'Sequence is the order that allows the chaos.',nextTitle:'Barrel Path',nextHref:'/learn/barrel-path'},
'barrel-path':{number:'04',title:'Barrel Path',problem:'Quality contact',definition:'Barrel path is the route the barrel takes to the baseball. A quality path creates access to more pitches and a larger window for quality contact.',purpose:'The best path does more than produce one perfect result. It makes the hitter more forgiving when timing is slightly early or late.',misconception:'There is not one universal barrel path or one universal contact position. The correct path depends on where the pitch is.',quote:'Where is the pitch?',nextTitle:'Adjustability',nextHref:'/learn/adjustability'},
adjustability:{number:'05',title:'Adjustability',problem:'Changing pitches',definition:'Adjustability is the ability to preserve the foundation while changing the solution for different speeds, locations, and game situations.',purpose:'Inside and outside pitches require different firing times, contact points, and barrel paths. The hitter must adapt without abandoning the underlying principles.',misconception:'Adjustability does not mean repeating one beautiful swing against every pitch. It means repeatedly solving new problems.',quote:'The foundation stays the same. The solution changes.',nextTitle:'Launch Assessment',nextHref:'/assessment'}
};
export function getStaticPaths(){return Object.keys(chapters).map(slug=>({params:{slug}}));}
const c=chapters[Astro.params.slug];
---
<BaseLayout title={`${c.title} | Launch Baseball`}><main><section class="hero"><div class="container"><p class="eyebrow">Chapter {c.number}</p><h1>{c.title}</h1><p>The problem it solves: <strong>{c.problem}</strong></p></div></section><section class="paper"><div class="container layout"><article><h2>What it is</h2><p>{c.definition}</p><h2>Why it matters</h2><p>{c.purpose}</p><h2>Common misconception</h2><p>{c.misconception}</p><div class="quote">{c.quote}</div></article><aside><p class="eyebrow">Apply it to your swing</p><p>Understanding the principle is different from knowing how it affects your movement.</p><a class="text-link" href="/assessment">See the Launch Assessment →</a></aside></div></section><section class="next"><div class="container"><span>Next chapter</span><a href={c.nextHref}>{c.nextTitle} →</a></div></section></main><style>.hero{padding:7rem 0 5rem;background:radial-gradient(circle at 80% 20%,rgba(211,41,47,.2),transparent 28%),linear-gradient(135deg,var(--navy),var(--navy2))}.hero h1{margin:.5rem 0 1rem;font-size:clamp(4rem,10vw,8rem);text-transform:uppercase}.hero p:last-child{color:#b8c4cf}.hero strong{color:white}.paper{background:var(--paper);color:var(--ink);padding:6rem 0}.layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:5rem;align-items:start}article{max-width:760px}article h2{margin:3rem 0 .8rem;font-size:2rem;text-transform:uppercase}article h2:first-child{margin-top:0}article p{color:#3e4a55;font-size:1.1rem}aside{position:sticky;top:110px;padding:1.4rem;border-left:4px solid var(--red);background:white}aside p{color:#4d5964}.quote{margin-top:4rem;padding-top:2.5rem;border-top:1px solid rgba(11,23,35,.13);font-size:clamp(2rem,4vw,3.7rem);font-weight:950;line-height:1;text-transform:uppercase}.next{background:#0a1c30}.next .container{min-height:180px;display:flex;justify-content:space-between;align-items:center;gap:2rem}.next span{color:var(--muted);text-transform:uppercase;font-size:.75rem;letter-spacing:.14em;font-weight:900}.next a{text-decoration:none;font-size:clamp(2rem,4vw,4rem);font-weight:950;text-transform:uppercase}@media(max-width:820px){.layout{grid-template-columns:1fr}aside{position:static}.next .container{align-items:flex-start;flex-direction:column;justify-content:center}}</style></BaseLayout>
