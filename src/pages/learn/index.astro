---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChapterCard from '../../components/ChapterCard.astro';
---
<BaseLayout title="Learn Hitting | Launch Baseball"><main><section class="hero"><div class="container"><p class="eyebrow">Open hitting curriculum</p><h1>Learn the foundation.</h1><p>The principles are not secret. They are organized here so players, parents, and coaches can understand them.</p></div></section><section class="content"><div class="container"><a class="foundation" href="/learn/foundation"><span>Start here</span><h2>Foundation</h2><p>The movement principles shared by successful hitters.</p></a><div class="cards"><ChapterCard number="01" title="Load" problem="Preparation" href="/learn/load"/><ChapterCard number="02" title="Balance" problem="Control" href="/learn/balance"/><ChapterCard number="03" title="Sequence" problem="Coordination" href="/learn/sequence"/><ChapterCard number="04" title="Barrel Path" problem="Quality contact" href="/learn/barrel-path"/><ChapterCard number="05" title="Adjustability" problem="Changing pitches" href="/learn/adjustability"/></div></div></section></main><style>.hero{padding:7rem 0 5rem;background:linear-gradient(135deg,var(--navy),var(--navy2))}h1{margin:.4rem 0 1rem;font-size:clamp(4rem,9vw,8rem);text-transform:uppercase}.hero p:last-child{max-width:720px;color:#b8c4cf;font-size:1.15rem}.content{padding:6rem 0;background:#091d33}.foundation{display:block;padding:2rem;margin-bottom:1rem;text-decoration:none;background:var(--red)}.foundation span{text-transform:uppercase;letter-spacing:.12em;font-size:.7rem;font-weight:950}.foundation h2{margin:.4rem 0;font-size:clamp(2.5rem,5vw,4.5rem);text-transform:uppercase}.foundation p{margin:0}.cards{display:grid;grid-template-columns:repeat(5,1fr);gap:.8rem}@media(max-width:1000px){.cards{grid-template-columns:repeat(2,1fr)}}@media(max-width:700px){.cards{grid-template-columns:1fr}}</style></BaseLayout>
